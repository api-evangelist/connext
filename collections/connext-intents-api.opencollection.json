{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chimera Intents API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Intents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get intents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.testnet.everclear.org/intents",
            "params": [
              {
                "name": "cursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "prevCursor",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "statuses",
                "value": "",
                "type": "query"
              },
              {
                "name": "origins",
                "value": "",
                "type": "query"
              },
              {
                "name": "destinations",
                "value": "",
                "type": "query"
              },
              {
                "name": "allDestinations",
                "value": "",
                "type": "query"
              },
              {
                "name": "txHash",
                "value": "",
                "type": "query"
              },
              {
                "name": "userAddress",
                "value": "",
                "type": "query"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "tickerHash",
                "value": "",
                "type": "query"
              },
              {
                "name": "isFastPath",
                "value": "",
                "type": "query",
                "description": "Filter for fast path intents (intents with TTL > 0)"
              }
            ]
          },
          "docs": "Retrieves a paginated list of intents based on query parameters"
        },
        {
          "info": {
            "name": "Create new intent(s)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.testnet.everclear.org/intents",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Endpoint to generate a TransactionRequest for one or multiple intents. For multiple intents, the transaction will target a fee adapter contract with appropriately formatted calldata."
        },
        {
          "info": {
            "name": "Get intent details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.testnet.everclear.org/intents/:intentId",
            "params": [
              {
                "name": "intentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Fetches detailed information for a specified intent by its ID"
        },
        {
          "info": {
            "name": "Execute calldata",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.testnet.everclear.org/intents/:intentId/execute",
            "params": [
              {
                "name": "intentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "The request object for `executeIntentCalldata`, used for self-execution"
        },
        {
          "info": {
            "name": "Return unsupported intent",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.testnet.everclear.org/intents/:intentId/return-unsupported",
            "params": [
              {
                "name": "intentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "The request object for `returnUnsupportedIntent` on hub domain"
        }
      ]
    }
  ],
  "bundled": true
}